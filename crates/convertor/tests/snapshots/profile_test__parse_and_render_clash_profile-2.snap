    url: "http://127.0.0.1:8080/subscription/proxy-provider?server=http%3A%2F%2F127.0.0.1%3A8080%2F&client=clash&interval=86400&strict=true&proxy_provider_name=convertor&sub_url=cWfEQlE7MX2XMGqWoHSXLzmn6tLjFEMgQzN9f5rech_2VsZDNsdax9FCmW6MnbAimRrbpmWBvamVk3H3JciNB7O7-k2xrhrRP5VvePh8q0CFG97FNuO06PLIRK3ky3-bCyY"
