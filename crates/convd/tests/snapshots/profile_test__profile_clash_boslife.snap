# DIRECT,force-remote-dns





port: 7890
socks-port: 7891
redir-port: 7892
allow-lan: true
mode: Rule
log-level: info
external-controller: '0.0.0.0:9090'
external-ui: ''
secret: ''
geo-auto-update: true
geo-update-interval: 24
geox-url: {"asn":"http://127.0.0.1:8080/download?0%5B0%5D=url&0%5B1%5D=https%3A%2F%2Fgithub.com%2Fxishang0128%2Fgeoip%2Freleases%2Fdownload%2Flatest%2FGeoLite2-ASN.mmdb","geoip":"http://127.0.0.1:8080/download?0%5B0%5D=url&0%5B1%5D=https%3A%2F%2Ftestingcf.jsdelivr.net%2Fgh%2FMetaCubeX%2Fmeta-rules-dat%40release%2Fgeoip.dat","geosite":"http://127.0.0.1:8080/download?0%5B0%5D=url&0%5B1%5D=https%3A%2F%2Ftestingcf.jsdelivr.net%2Fgh%2FMetaCubeX%2Fmeta-rules-dat%40release%2Fgeosite.dat","mmdb":"http://127.0.0.1:8080/download?0%5B0%5D=url&0%5B1%5D=https%3A%2F%2Ftestingcf.jsdelivr.net%2Fgh%2FMetaCubeX%2Fmeta-rules-dat%40release%2Fcountry.mmdb"}
proxy-providers:
  convertor:
    type: "http"
    url: "http://127.0.0.1:8080/subscription/proxy-provider?server=http%3A%2F%2F127.0.0.1%3A8080%2F&client=clash&interval=0&strict=false&proxy_provider_name=convertor&sub_url=http%3A%2F%2F127.0.0.1%2Fapi%2Foriginal%3Ftoken%3Dbppleman%26flag%3Dclash"
    path: "./proxy_providers/convertor.yaml"
    interval: 0
    proxy: "DIRECT"
    size-limit: 0
proxy-groups:

  - { name: BosLife, type: select, proxies: [ '🇭🇰 香港组', '🇸🇬 新加坡组', '🇨🇳🏳️‍🌈 台湾组', '🇯🇵 日本组', '🇺🇸 美国组', '🇨🇦 加拿大组', '🇰🇷 韩国组', '🇬🇧 英国组', '🇫🇷 法国组', '🇩🇪 德国组' ] }
  - { name: 'Subscription Info', type: select, use: [ convertor ], filter: '(?i)(剩余流量：43.9 GB|距离下次重置剩余：15 天|套餐到期：2026-04-22)' }
  - { name: '🇭🇰 香港组', type: url-test, use: [ convertor ], filter: '(?i)🇭🇰 香港' }
  - { name: '🇸🇬 新加坡组', type: url-test, use: [ convertor ], filter: '(?i)🇸🇬 新加坡' }
  - { name: '🇨🇳🏳️‍🌈 台湾组', type: url-test, use: [ convertor ], filter: '(?i)🏳️‍🌈 台湾' }
  - { name: '🇯🇵 日本组', type: url-test, use: [ convertor ], filter: '(?i)🇯🇵 日本' }
  - { name: '🇺🇸 美国组', type: url-test, use: [ convertor ], filter: '(?i)🇺🇸 美国' }
  - { name: '🇨🇦 加拿大组', type: url-test, use: [ convertor ], filter: '(?i)🇨🇦 加拿大 01' }
  - { name: '🇰🇷 韩国组', type: url-test, use: [ convertor ], filter: '(?i)🇰🇷 韩国 01' }
  - { name: '🇬🇧 英国组', type: url-test, use: [ convertor ], filter: '(?i)🇬🇧 英国 01' }
  - { name: '🇫🇷 法国组', type: url-test, use: [ convertor ], filter: '(?i)🇫🇷 法国 01' }
  - { name: '🇩🇪 德国组', type: url-test, use: [ convertor ], filter: '(?i)🇩🇪 德国 01' }
rule-providers:
  Subscription_policy:
    type: "http"
    url: "http://127.0.0.1:8080/subscription/rule-provider?server=http%3A%2F%2F127.0.0.1%3A8080%2F&client=clash&interval=0&strict=false&policy%5Bname%5D=DIRECT&policy%5Boption%5D&policy%5Bis_subscription%5D=true&sub_url=http%3A%2F%2F127.0.0.1%2Fapi%2Foriginal%3Ftoken%3Dbppleman%26flag%3Dclash"
    path: "./rule_providers/Subscription_policy.yaml"
    interval: 0
    proxy: "DIRECT"
    size-limit: 0
    behavior: "classical"
    format: "yaml"
  BosLife_policy:
    type: "http"
    url: "http://127.0.0.1:8080/subscription/rule-provider?server=http%3A%2F%2F127.0.0.1%3A8080%2F&client=clash&interval=0&strict=false&policy%5Bname%5D=BosLife&policy%5Boption%5D&policy%5Bis_subscription%5D=false&sub_url=http%3A%2F%2F127.0.0.1%2Fapi%2Foriginal%3Ftoken%3Dbppleman%26flag%3Dclash"
    path: "./rule_providers/BosLife_policy.yaml"
    interval: 0
    proxy: "DIRECT"
    size-limit: 0
    behavior: "classical"
    format: "yaml"
  BosLife_no_resolve:
    type: "http"
    url: "http://127.0.0.1:8080/subscription/rule-provider?server=http%3A%2F%2F127.0.0.1%3A8080%2F&client=clash&interval=0&strict=false&policy%5Bname%5D=BosLife&policy%5Boption%5D=no-resolve&policy%5Bis_subscription%5D=false&sub_url=http%3A%2F%2F127.0.0.1%2Fapi%2Foriginal%3Ftoken%3Dbppleman%26flag%3Dclash"
    path: "./rule_providers/BosLife_no_resolve.yaml"
    interval: 0
    proxy: "DIRECT"
    size-limit: 0
    behavior: "classical"
    format: "yaml"
  BosLife_force_remote_dns:
    type: "http"
    url: "http://127.0.0.1:8080/subscription/rule-provider?server=http%3A%2F%2F127.0.0.1%3A8080%2F&client=clash&interval=0&strict=false&policy%5Bname%5D=BosLife&policy%5Boption%5D=force-remote-dns&policy%5Bis_subscription%5D=false&sub_url=http%3A%2F%2F127.0.0.1%2Fapi%2Foriginal%3Ftoken%3Dbppleman%26flag%3Dclash"
    path: "./rule_providers/BosLife_force_remote_dns.yaml"
    interval: 0
    proxy: "DIRECT"
    size-limit: 0
    behavior: "classical"
    format: "yaml"
  DIRECT_policy:
    type: "http"
    url: "http://127.0.0.1:8080/subscription/rule-provider?server=http%3A%2F%2F127.0.0.1%3A8080%2F&client=clash&interval=0&strict=false&policy%5Bname%5D=DIRECT&policy%5Boption%5D&policy%5Bis_subscription%5D=false&sub_url=http%3A%2F%2F127.0.0.1%2Fapi%2Foriginal%3Ftoken%3Dbppleman%26flag%3Dclash"
    path: "./rule_providers/DIRECT_policy.yaml"
    interval: 0
    proxy: "DIRECT"
    size-limit: 0
    behavior: "classical"
    format: "yaml"
  DIRECT_no_resolve:
    type: "http"
    url: "http://127.0.0.1:8080/subscription/rule-provider?server=http%3A%2F%2F127.0.0.1%3A8080%2F&client=clash&interval=0&strict=false&policy%5Bname%5D=DIRECT&policy%5Boption%5D=no-resolve&policy%5Bis_subscription%5D=false&sub_url=http%3A%2F%2F127.0.0.1%2Fapi%2Foriginal%3Ftoken%3Dbppleman%26flag%3Dclash"
    path: "./rule_providers/DIRECT_no_resolve.yaml"
    interval: 0
    proxy: "DIRECT"
    size-limit: 0
