  DIRECT_force_remote_dns:
    type: "http"
    url: "http://127.0.0.1:8080/subscription/rule-provider?server=http%3A%2F%2F127.0.0.1%3A8080%2F&client=clash&interval=0&strict=false&policy%5Bname%5D=DIRECT&policy%5Boption%5D=force-remote-dns&policy%5Bis_subscription%5D=false&sub_url=http%3A%2F%2F127.0.0.1%2Fapi%2Foriginal%3Ftoken%3Dbppleman%26flag%3Dclash"
    path: "./rule_providers/DIRECT_force_remote_dns.yaml"
    interval: 0
    proxy: "DIRECT"
    size-limit: 0
    behavior: "classical"
    format: "yaml"
rules:
  - "RULE-SET,Subscription_policy,DIRECT"
  - "RULE-SET,BosLife_policy,BosLife"
  - "RULE-SET,BosLife_no_resolve,BosLife,no-resolve"
  - "RULE-SET,BosLife_force_remote_dns,BosLife,force-remote-dns"
  - "RULE-SET,DIRECT_policy,DIRECT"
  - "RULE-SET,DIRECT_no_resolve,DIRECT,no-resolve"
  - "RULE-SET,DIRECT_force_remote_dns,DIRECT,force-remote-dns"
  - 'GEOIP,CN,DIRECT'
  - 'MATCH,DIRECT'
